# ---- Pick your SOURCE (reads the comments). Today: unipile or csv. ----
NAUGHTY_SOURCE=unipile

# ---- Pick your SENDER (delivers the message). unipile | heyreach | lemlist ----
NAUGHTY_SENDER=unipile

# Unipile — the only provider that can read post comments and profile headlines.
UNIPILE_API_KEY=
UNIPILE_DSN=https://apiXX.unipile.com:NNNNN
UNIPILE_ACCOUNT_ID=
UNIPILE_OWN_PROVIDER_ID=

# HeyReach — sender only. Needs a campaign that starts with a connection step.
HEYREACH_API_KEY=
HEYREACH_CAMPAIGN_ID=
HEYREACH_LIST_ID=

# lemlist — sender only, and DM only. It has no invite endpoint on the API.
LEMLIST_API_KEY=

# ---- Where the board lives: local | notion  (set by `naughty init`) ----
NAUGHTY_TRACKER=local

# Notion, only if NAUGHTY_TRACKER=notion. The database must be shared with your
# integration or every call 404s.
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Your own display name, so the detector can spot a mention parked at the end of a line.
NAUGHTY_OWNER_NAME=
